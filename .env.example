# Copie para ".env" (cp .env.example .env) e ajuste. O .env NÃO vai para o Git.

# --- Banco de dados ----------------------------------------------------------
DB_NAME=boardpoint
DB_USER=boardpoint
DB_PASS=troque_esta_senha
DB_ROOT_PASS=troque_a_senha_do_root

# --- Chave PIX (obrigatória para o checkout funcionar) ------------------------
PIX_CHAVE=
PIX_NOME_RECEBEDOR="BOARD POINT"
PIX_CIDADE="CAMPO MOURAO"

# --- Porta em que o site abre no seu computador -------------------------------
HTTP_PORT=8081
