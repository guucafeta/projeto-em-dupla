{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "outDir": "../js",
    "rootDir": ".",
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
